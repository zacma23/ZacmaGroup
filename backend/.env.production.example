# ===========================================================================
# ZACMA BACKEND API — PRODUCTION ENVIRONMENT TEMPLATE
# ===========================================================================

APP_NAME="Zacma Business Management API"
APP_ENV=production
APP_ENVIRONMENT=production
DEMO_MODE=false
DEMO_TENANT_ID=zacma-live
CORS_ORIGINS=https://zacma.com,https://app.zacma.com,https://portal.zacma.com,https://api.zacma.com

# Database (PostgreSQL Connection String)
DATABASE_URL=postgresql://postgres.yourprojectid:YourSecureDBPassword@aws-0-region.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://yourprojectid.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Chapa Gateway Credentials
PAYMENT_ENVIRONMENT=live
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_SECRET_KEY=CHASECK_LIVE-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_PUBLIC_KEY=CHAPUBK_LIVE-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_WEBHOOK_SECRET=your_live_chapa_webhook_secret_here
CHAPA_CALLBACK_URL=https://api.zacma.com/api/v1/payments/webhooks/chapa
CHAPA_RETURN_URL=https://zacma.com/portal?payment_status=success

# Telegram Bot
TELEGRAM_BOT_TOKEN=8903928763:AAFrzueg5A4RU3u3Y64YhflZwhJ5dKXZjNw

# Automation Service
AUTOMATION_WEBHOOK_URL=https://n8n.zacma.com/webhook/zacma-service-fulfillment
AUTOMATION_WEBHOOK_SECRET=your_enterprise_automation_hmac_secret_key

# AI Gateway
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Redis & Cache
REDIS_URL=redis://default:YourRedisPassword@redis:6379

# Email
MAIL_FROM=support@zacma.com
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_password

# JWT & Cryptography
SECRET_KEY=generate_a_64_char_cryptographically_secure_random_key_for_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
