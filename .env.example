# ==============================================================================
# ZACMA UNIFIED ENTERPRISE SAAS PLATFORM — CONFIGURATION ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env (or backend/.env and dashboard/.env.local) and customize.
# Local Demo Mode is enabled by default to allow offline development without cloud credentials.

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# ------------------------------------------------------------------------------
APP_ENV=development                       # 'development', 'staging', 'production'
DEMO_MODE=true                            # Set 'false' in staging/production with real credentials
DEMO_TENANT_ID=zacma-demo
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# ------------------------------------------------------------------------------
# 2. GOOGLE CLOUD PLATFORM & CLOUD RUN
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=zacma-platform
GCP_REGION=us-central1
GOOGLE_CLOUD_PROJECT=zacma-platform

# ------------------------------------------------------------------------------
# 3. FIREBASE AUTHENTICATION (Optional Add-on / Enterprise Auth)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=zacma-platform
# Path to service account JSON file if validating tokens via Admin SDK locally
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json

# ------------------------------------------------------------------------------
# 4. DATABASE / GOOGLE CLOUD SQL POSTGRESQL
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zacma
# Cloud SQL Connection String format:
# DATABASE_URL=postgresql://dbuser:dbpass@/zacma?host=/cloudsql/zacma-platform:us-central1:zacma-db
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_KEY=replace-me

# ------------------------------------------------------------------------------
# 5. GOOGLE CLOUD STORAGE (SECURE PRIVATE DOCUMENTS & RECEIPTS)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local                    # 'local' or 'gcs'
GCP_STORAGE_BUCKET=zacma-private-documents-zacma-platform

# ------------------------------------------------------------------------------
# 6. GOOGLE PUB/SUB ASYNCHRONOUS EVENT BUS
# ------------------------------------------------------------------------------
GCP_PUBSUB_ENABLED=false                  # Set 'true' in GCP staging/production
GCP_PUBSUB_TOPIC=zacma-platform-events

# ------------------------------------------------------------------------------
# 7. AUTOMATION ENGINE & GOOGLE CLOUD WORKFLOWS / n8n
# ------------------------------------------------------------------------------
AUTOMATION_ENGINE=google_workflows        # 'google_workflows', 'n8n', 'mock'
AUTOMATION_WEBHOOK_SECRET=zacma_automation_secret_key_change_in_prod

# ------------------------------------------------------------------------------
# 8. MULTI-PROVIDER AI GATEWAY (GEMINI, OLLAMA, OPENAI, GROK, ANTHROPIC)
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini                        # 'gemini', 'ollama', 'openai', 'anthropic'
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash                 # Default lightweight high-speed model
# Ollama / Open-Source Local Fallback:
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

# ------------------------------------------------------------------------------
# 9. CHAPA & MULTI-CHANNEL PAYMENTS (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
PAYMENT_ENV=test                          # 'test' or 'live'
CHAPA_KEY=CHASECK_TEST-your_chapa_secret_key
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-your_chapa_public_key
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret
CHAPA_CALLBACK_URL=http://127.0.0.1:8000/api/v1/payments/webhooks/chapa
CHAPA_RETURN_URL=http://localhost:3000/portal?payment_status=success

# ------------------------------------------------------------------------------
# 10. TELEGRAM BOT NOTIFICATIONS & INVOICE TRACKING
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=8903928763:AAFrzueg5A4RU3u3Y64YhflZwhJ5dKXZjNw
TELEGRAM_BOT_USERNAME=ZacmaBusinessSupportAI_bot

# ------------------------------------------------------------------------------
# 11. FRONTEND NEXT.JS PUBLIC CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=zacma-platform.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=zacma-platform
