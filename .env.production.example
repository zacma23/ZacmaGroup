# ===========================================================================
# ZACMA PLATFORM — PRODUCTION ENVIRONMENT TEMPLATE (.env.production)
# ===========================================================================

# 1. Application & Domain Configuration
APP_ENV=production
APP_ENVIRONMENT=production
DEMO_MODE=false
DEMO_TENANT_ID=zacma-live
CORS_ORIGINS=https://zacma.com,https://app.zacma.com,https://portal.zacma.com,https://api.zacma.com

# 2. Database & Supabase Infrastructure (PostgreSQL with RLS)
DATABASE_URL=postgresql://postgres.yourprojectid:YourSecureDBPassword@aws-0-region.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://yourprojectid.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# 3. SantimPay Payment Gateway (Live Production)
PAYMENT_ENVIRONMENT=live
SANTIMPAY_MERCHANT_ID=your_live_santimpay_merchant_id
SANTIMPAY_GATEWAY_TOKEN=your_live_santimpay_gateway_token
SANTIMPAY_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\nyour_live_private_key_here\n-----END EC PRIVATE KEY-----"
SANTIMPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nyour_live_public_key_here\n-----END PUBLIC KEY-----"
SANTIMPAY_BASE_URL=https://services.santimpay.com/api/v1/gateway
SANTIMPAY_TESTBED=false
SANTIMPAY_CALLBACK_URL=https://api.zacma.com/api/v1/payments/webhooks/santimpay
SANTIMPAY_RETURN_URL=https://zacma.com/portal?payment_status=success
SANTIMPAY_FAILURE_URL=https://zacma.com/portal?payment_status=failed
SANTIMPAY_CANCEL_URL=https://zacma.com/portal?payment_status=cancelled

# 4. Telegram Business Support & Payment Bot (@ZacmaBusinessSupportAI_bot)
TELEGRAM_BOT_TOKEN=8903928763:AAFrzueg5A4RU3u3Y64YhflZwhJ5dKXZjNw

# 5. Enterprise Automation & Workflow Webhooks (n8n / External Integrations)
AUTOMATION_WEBHOOK_URL=https://n8n.zacma.com/webhook/zacma-service-fulfillment
AUTOMATION_WEBHOOK_SECRET=your_enterprise_automation_hmac_secret_key

# 6. AI Multi-Provider Configuration (openai, anthropic, grok, openrouter, ollama)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 7. Redis Cache, Rate Limiting & Queue
REDIS_URL=redis://default:YourRedisPassword@redis-cluster.internal:6379

# 8. SMTP Email Gateway (Transactional Notifications)
MAIL_FROM=support@zacma.com
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_or_smtp_password

# 9. JWT Signing & Security
SECRET_KEY=generate_a_64_char_cryptographically_secure_random_key_for_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
